# Optional provider configuration. AI is disabled when these are unset.
AI_PROVIDER=disabled
AI_MODEL=
AI_API_KEY=

# Supabase connection. Keep the service key private and never commit .env.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

# Local data locations
PRICECATCHER_RAW_DIR=data/raw/pricecatcher
PRICECATCHER_PROCESSED_DIR=data/processed/pricecatcher
